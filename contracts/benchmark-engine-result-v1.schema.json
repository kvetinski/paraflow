{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-engine-result-v1.schema.json",
  "title": "ParaFlow benchmark engine result v1",
  "description": "Raw engine-side samples and build identity returned by one Rust benchmark process.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "scenario_name",
    "workload_name",
    "execution",
    "sampling",
    "timing",
    "correctness",
    "engine_build",
    "samples",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "paraflow.benchmark-engine-result/v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
    },
    "scenario_name": {
      "$ref": "#/$defs/name"
    },
    "workload_name": {
      "$ref": "#/$defs/name"
    },
    "execution": {
      "$ref": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-suite-v1.schema.json#/$defs/execution"
    },
    "sampling": {
      "$ref": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-suite-v1.schema.json#/$defs/sampling"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "correctness": {
      "$ref": "#/$defs/correctness"
    },
    "engine_build": {
      "$ref": "#/$defs/engineBuild"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/sample"
      }
    },
    "result": {
      "$ref": "https://github.com/kvetinski/paraflow/blob/main/contracts/execution-protocol-v1.schema.json#/$defs/result"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "u64Hex": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{16}$"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "unit",
        "process_start_in_samples",
        "experiment_total_ns"
      ],
      "properties": {
        "clock": {
          "const": "std::time::Instant"
        },
        "unit": {
          "const": "nanoseconds"
        },
        "process_start_in_samples": {
          "const": false
        },
        "experiment_total_ns": {
          "$ref": "#/$defs/u64Hex"
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "oracle",
        "comparison"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "oracle": {
          "const": "rust-scalar-v1"
        },
        "comparison": {
          "const": "exact"
        }
      }
    },
    "engineBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profile",
        "target",
        "rustc",
        "source_commit",
        "source_state"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "rustc": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "minLength": 1
        },
        "source_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "generation_ns",
        "pipeline_ns",
        "engine_total_ns"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "generation_ns": {
          "$ref": "#/$defs/u64Hex"
        },
        "pipeline_ns": {
          "$ref": "#/$defs/u64Hex"
        },
        "engine_total_ns": {
          "$ref": "#/$defs/u64Hex"
        }
      }
    }
  }
}
