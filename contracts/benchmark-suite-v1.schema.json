{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-suite-v1.schema.json",
  "title": "ParaFlow benchmark suite v1",
  "description": "A reproducible collection of scalar benchmark scenarios. Workload meaning remains in workload-v1 files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "paraflow.benchmark-suite/v1"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "const": "scalar"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_iterations",
        "sample_iterations"
      ],
      "properties": {
        "warmup_iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "sample_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "workload",
        "execution",
        "sampling"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "workload": {
          "$ref": "#/$defs/repositoryPath"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        }
      }
    }
  }
}
