{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-vectors-v1.schema.json",
  "title": "ParaFlow benchmark protocol vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "paraflow.benchmark-vectors/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "request",
          "engine_result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "$ref": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-request-v1.schema.json"
          },
          "engine_result": {
            "$ref": "https://github.com/kvetinski/paraflow/blob/main/contracts/benchmark-engine-result-v1.schema.json"
          }
        }
      }
    }
  }
}
