{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvetinski/paraflow/blob/main/contracts/environment-v3.schema.json",
  "title": "ParaFlow environment report v3",
  "description": "Host, source, and toolchain metadata captured for Day 5 benchmark and Day 6 profile evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "captured_at",
    "os",
    "kernel_version",
    "architecture",
    "cpu_model",
    "physical_cores",
    "logical_cpus",
    "gomaxprocs",
    "go_version",
    "source",
    "ready",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "paraflow.environment/v3"
    },
    "milestone": {
      "enum": [
        "day-05",
        "day-06"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "os": {
      "type": "string",
      "minLength": 1
    },
    "kernel_version": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "string",
      "minLength": 1
    },
    "cpu_model": {
      "type": "string",
      "minLength": 1
    },
    "physical_cores": {
      "type": "integer",
      "minimum": 0
    },
    "logical_cpus": {
      "type": "integer",
      "minimum": 1
    },
    "gomaxprocs": {
      "type": "integer",
      "minimum": 1
    },
    "go_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "ready": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "sourceState": {
      "enum": [
        "clean",
        "dirty",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "full_commit",
        "source_state"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "full_commit": {
          "type": "string",
          "minLength": 1
        },
        "source_state": {
          "$ref": "#/$defs/sourceState"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_now",
        "introduced",
        "purpose",
        "found",
        "usable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required_now": {
          "type": "boolean"
        },
        "minimum_version": {
          "type": "string",
          "minLength": 1
        },
        "introduced": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "found": {
          "type": "boolean"
        },
        "usable": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
