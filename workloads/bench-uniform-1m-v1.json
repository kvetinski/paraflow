{
  "$schema": "../contracts/workload-v1.schema.json",
  "schema_version": "paraflow.workload/v1",
  "name": "bench-uniform-1m-v1",
  "dataset": {
    "record_count": 1048576,
    "seed": 149,
    "generator": "splitmix64-v1",
    "distribution": {
      "kind": "uniform"
    },
    "feature_min": -10000,
    "feature_max": 10000,
    "category_count": 16,
    "flag_probability_bps": 2500
  },
  "pipeline": {
    "normalize": {
      "offset_a": 0.0,
      "scale_a": 0.001,
      "offset_b": 0.0,
      "scale_b": 0.001,
      "clip": 8.0
    },
    "score": {
      "weight_a": 0.7,
      "weight_b": -0.2,
      "bias": 0.1,
      "flag_mask": 1,
      "flag_bonus": 0.25
    },
    "filter": {
      "min_score": 0.5
    },
    "aggregate": {
      "histogram": "category"
    }
  }
}
