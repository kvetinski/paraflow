{
  "$schema": "../contracts/workload-v1.schema.json",
  "schema_version": "paraflow.workload/v1",
  "name": "edge-scalar-mask-v1",
  "dataset": {
    "record_count": 1,
    "seed": 149,
    "generator": "splitmix64-v1",
    "distribution": {
      "kind": "uniform"
    },
    "feature_min": 0,
    "feature_max": 1,
    "category_count": 1,
    "flag_probability_bps": 10000
  },
  "pipeline": {
    "normalize": {
      "offset_a": 0.0,
      "scale_a": 1.0,
      "offset_b": 0.0,
      "scale_b": 1.0,
      "clip": 1.0
    },
    "score": {
      "weight_a": 0.0,
      "weight_b": 0.0,
      "bias": 1.0,
      "flag_mask": 3,
      "flag_bonus": 1.0
    },
    "filter": {
      "min_score": 1.0
    },
    "aggregate": {
      "histogram": "category"
    }
  }
}
