{
  "$schema": "../contracts/workload-v1.schema.json",
  "schema_version": "paraflow.workload/v1",
  "name": "edge-scalar-ops-v1",
  "dataset": {
    "record_count": 2,
    "seed": 149,
    "generator": "splitmix64-v1",
    "distribution": {
      "kind": "uniform"
    },
    "feature_min": 0,
    "feature_max": 1,
    "category_count": 1,
    "flag_probability_bps": 0
  },
  "pipeline": {
    "normalize": {
      "offset_a": 3.0,
      "scale_a": 0.5,
      "offset_b": -2.0,
      "scale_b": 2.0,
      "clip": 3.0
    },
    "score": {
      "weight_a": 2.0,
      "weight_b": 0.5,
      "bias": 0.0,
      "flag_mask": 0,
      "flag_bonus": 0.25
    },
    "filter": {
      "min_score": 1.75
    },
    "aggregate": {
      "histogram": "category"
    }
  }
}
