{
  "$schema": "../contracts/workload-v1.schema.json",
  "schema_version": "paraflow.workload/v1",
  "name": "edge-scalar-v1",
  "dataset": {
    "record_count": 8,
    "seed": 18,
    "generator": "splitmix64-v1",
    "distribution": {
      "kind": "uniform"
    },
    "feature_min": -4,
    "feature_max": 5,
    "category_count": 4,
    "flag_probability_bps": 5000
  },
  "pipeline": {
    "normalize": {
      "offset_a": 0.0,
      "scale_a": 1.0,
      "offset_b": 0.0,
      "scale_b": 1.0,
      "clip": 2.0
    },
    "score": {
      "weight_a": 1.0,
      "weight_b": 0.5,
      "bias": 0.0,
      "flag_mask": 1,
      "flag_bonus": 0.5
    },
    "filter": {
      "min_score": 1.0
    },
    "aggregate": {
      "histogram": "category"
    }
  }
}
