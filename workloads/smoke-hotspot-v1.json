{
  "$schema": "../contracts/workload-v1.schema.json",
  "schema_version": "paraflow.workload/v1",
  "name": "smoke-hotspot-v1",
  "dataset": {
    "record_count": 1024,
    "seed": 2026,
    "generator": "splitmix64-v1",
    "distribution": {
      "kind": "hotspot",
      "category": 3,
      "probability_bps": 8000
    },
    "feature_min": -64,
    "feature_max": 64,
    "category_count": 8,
    "flag_probability_bps": 5000
  },
  "pipeline": {
    "normalize": {
      "offset_a": 0.0,
      "scale_a": 0.125,
      "offset_b": 0.0,
      "scale_b": 0.125,
      "clip": 8.0
    },
    "score": {
      "weight_a": 0.7,
      "weight_b": -0.2,
      "bias": 0.1,
      "flag_mask": 1,
      "flag_bonus": 0.25
    },
    "filter": {
      "min_score": 0.5
    },
    "aggregate": {
      "histogram": "category"
    }
  }
}
